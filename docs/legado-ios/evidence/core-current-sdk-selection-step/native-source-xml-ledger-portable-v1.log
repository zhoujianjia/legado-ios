ations.rb\n          bash -n scripts/reader-experience/renewal-probe-tests.sh\n          bash -n scripts/reader-experience/original-api-package-tests.sh\n      - name: Select the installed toolchain and Simulator\n        id: toolchain\n        if: ${{ !cancelled() && steps.source.outcome == \'success\' }}\n        run: |\n          export DEVELOPER_DIR="$(bash scripts/sim.sh xcode)"\n          export YUEDU_DEST="$(bash scripts/sim.sh dest)"\n          echo "DEVELOPER_DIR=$DEVELOPER_DIR" >> "$GITHUB_ENV"\n          echo "YUEDU_DEST=$YUEDU_DEST" >> "$GITHUB_ENV"\n          xcodebuild -version 2>&1 | tee .build/ci-logs/reader-renewal-xcode.log\n      - name: Execute314 current-core definitions with316 exact native argument leaves\n        if: ${{ !cancelled() && steps.source.outcome == \'success\' && steps.toolchain.outcome == \'success\' }}\n        env:\n          YUEDU_RENEWAL_PORTABLE_GUARDS_OUTCOME: ${{ steps.guards.outcome }}\n        run: bash scripts/reader-experience/renewal-probe-tests.sh 2>&1 | tee .build/ci-logs/reader-renewal.log\n      - name: Execute16 independent current-source macOS package XCTest cases\n        if: ${{ !cancelled() && steps.toolchain.outcome == \'success\' && (env.YUEDU_RENEWAL_SELECTION == \'controlledsigning\' || env.YUEDU_RENEWAL_SELECTION == \'transactionrenewal\' || env.YUEDU_RENEWAL_SELECTION == \'handoffrenewal\' || env.YUEDU_RENEWAL_SELECTION == \'currentcore\') }}\n        run: bash scripts/reader-experience/original-api-package-tests.sh 2>&1 | tee .build/ci-logs/reader-renewal-original-api.log\n      - name: Preserve independent package XCTest evidence without build products\n        if: ${{ always() && (env.YUEDU_RENEWAL_SELECTION == \'controlledsigning\' || env.YUEDU_RENEWAL_SELECTION == \'transactionrenewal\' || env.YUEDU_RENEWAL_SELECTION == \'handoffrenewal\' || env.YUEDU_RENEWAL_SELECTION == \'currentcore\') }}\n        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n   