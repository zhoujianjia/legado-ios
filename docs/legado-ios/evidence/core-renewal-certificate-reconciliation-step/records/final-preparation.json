      "client": "func reconcilePendingMaterials() async throws -> SelfRenewalSigningMaterialVault.Lease",
      "vault": "func publicationBaseline(in namespace: Namespace, expectedGeneration: UInt64) throws -> PublicationBaseline?",
      "metadata": "Private-init namespace/generation/keyID/actual sealed manifest leaf SHA256; nil only manifest.published==nil; current Keychain owner, cancellation, missing/corrupt/stale errors preserved; no key, lease or authority.",
      "localFinalize": "Actual Vault gen==pending.gen+1 AND certificateObserved invokes same local finalize: real lease/keyID/generation/leaf hash; credentials or new baseline are not required, no remote calls.",
      "remoteReconcile": "Exact current pending gen; new persisted complete normalized DER baseline + old published leaf + exact CSR DER hash mandatory; same live account/team/current CSR; unique new keymatching candidate; actual profile downloads and original full Vault.publish commit.",
      "oldFinalizeUnchanged": "Existing finalizeObservedPublication remains local-only; no implicit list or issuance.",
      "normalRefresh": "Same current CSR generation and current publication read twice around list; baseline durable before original single CSR; direct ACK old/baseline leaf refused."
    },
