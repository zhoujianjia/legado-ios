  "actualAppConnection": [
    "Existing App -> sole AppOwner.start -> same AppSession/Journal flock. Current-process material or vault unavailability can select only a typed recovery-only connection, never a Vault.Namespace proof",
    "Coordinator.recoveryOnly -> actual journal.load -> private transactionID/namespace UUID/candidate/path/pin/bundle binding; prepare/private submit/signature observation/read candidate verify first reject absent signing context",
    "App bootstrap/foreground do not connect to a device. Explicit recovery imports actual Keychain persistent SecIdentity reference and matching peer public certificate/pin, then calls the same Coordinator/InstallationRecovery",
    "Known remote uploadIntent/upgradeIntent/installationUnknown/receiptObserved/lookupObserved only. Unknown Upgrade always Lookup; no deletion, Upload, Upgrade or same-version-success inference",
    "Safe owned cleanup can return candidateReady; recovery-only retains candidate and cannot retire or start another signing cycle",
    "Persistent Status.access distinguishes signing/recoveryOnly; signing material failure stays independent of this recovery error or successful Lookup. UI includes five-language recovery-only warning"
  ],
  "materialFailurePolicy": {
    "selector": "explicit known material/crypto/expired profile/revoked or genuinely missing published key/namespace cases only",
    "notFallback": "Journal/POSIX/Cocoa errors, changed-during-read, budget failures, malformed manifest, all checked-Keychain errors/OSStatus, unknown error and cancellation",
    "checkedKeychain": "one existing KeychainHelper readCore; default Vault manifest read uses strict 512KiB validation before UTF8; only errSecItemNotFound returns nil",
    "errorsKept": "SigningMaterialUnavailable underlying+recoveryContextError; RecoveryFailed signingMaterials+recoveryError+observationError+actual completedRecovery separately",
    "configNotAuthority": "namespace UUID and peer DER pin compare existing record; actual identity lookup before storing recovery configuration. No signing key/namespace/lease is fabricated from JSON"
  },
