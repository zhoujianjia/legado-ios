+                if (raw === null) throw new Error('BROWSER_CANCELLED');
+                const reply = JSON.parse(raw);
+                if (reply.error) throw new Error(reply.error);
+                if (reply.kind === 'void') return undefined;
+                if (reply.kind === 'stringList') return reply.values == null ? null : reply.values;
+                return reply.value == null ? null : reply.value;
