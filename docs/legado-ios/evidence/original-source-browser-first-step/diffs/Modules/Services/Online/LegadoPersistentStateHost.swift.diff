+        } catch {
+            // Admission may have changed after UIKit accepted the page. This is
+            // still an unacknowledged task, not normal producer cleanup.
+            await SourceBrowserPresenter.cancelOriginal(taskID: request.taskID)
+            throw error
+        }
+    }
