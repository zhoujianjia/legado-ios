  "interfaces": {
    "Package": "LegadoOriginalLoginV2Models.swift; loginV2UIOriginal(session:stateJSON:) / loginV2ActionOriginal(session:action:stateJSON:form:)",
    "ServiceRender": "originalLoginV2UI(source:stateJSON: = \"{}\") -> LegadoOriginalLoginV2RenderReceipt(render:{rows,storedValues}, completedEffects)",
    "ServiceAction": "originalLoginV2Action(source:action:stateJSON:form:) -> LegadoOriginalLoginV2ActionReceipt(command:{stateJSON?,errors?,close,loginStored,unknownKeys}, completedEffects)",
    "V2Row": "name,type,key?,hint?,value?,options?,action?,countdown?,style?",
    "AppContract": [
      "Same BookSourceFormLoginView, no legacy OK/dismiss save for version2.",
      "Current View owns stateJSON initially{}, hidden sessionValues, controls, field errors, task generations and countdowns.",
      "collectForm returns only current text/password/select/toggle, then merges into hidden session Map; render precedence row.value then session input then stored.",
      "Action/save failure cannot close or commit candidate state; render failure keeps old UI/session/state and applies returned errors.",
      "Countdown starts on successful valid command with no errors even if next state render later fails; original dispatch refuses render/action/countdown overlap; toggle edits themselves are not rolled back on action failure."
    ]
  },
