  "unresolvedBlockingFindings": [],
  "resolvedBlockingFindings": [
    {
      "id": "font-stale-record-after-external-file-removal",
      "severity": "P2",
      "trigger": "A file managed in Documents/fonts is removed through Files while its persisted UserFontInfo remains.",
      "initialProblem": "The initial patch rejected both deletion of the stale record and same-name reimport with ENOENT, removing the previous self-repair paths.",
      "resolution": "Only pre-copy attributes lookup can establish original absence using explicit Cocoa/POSIX missing-file domains/codes. Copy-stage ENOENT still aborts. Missing-file size lookup is allowed to contribute zero bytes. The CoreText fileNotFound allowance independently checks that exact URL is absent; permission/in-use and other metadata errors still fail.",
      "sourceCases": [
        "UserFontSettingsTests/missingOldFilesCanBeRepaired(reimport:)",
        "UserFontSettingsTests/recoveryCopyMissingErrorStillAborts()",
        "UserFontSettingsTests/defaultRegistryCanRemoveAnAlreadyMissingFont()"
      ],
      "status": "source_fix_and_regression_cases_reviewed_runtime_execution_pending"
    }
  ],
  "reviewedContracts": {
    "rollbackAndBytes": "Existing regular files are backed up before unregister/removal. Attempted unregister is tracked before invocation; failures after removal restore bytes before re-registration. Rollback failure retains owned hidden recovery copies and throws. Originally absent files are not manufactured during rollback.",
    "recordAndSelectionPublication": "Import/delete await the detached synchronous worker and publish records plus the requested matching selection in one guarded MainActor turn only after success. Failures do not execute that publication.",
    "registrationScopes": "Registration retains persistent-then-process behavior. Checked unregistration visits persistent and process, tolerating notRegistered/unsupportedScope and narrowly confirmed missing URLs; the source does not ignore in-use or permission failures.",
    "securityScopeAndCancellation": "The three direct document-import UI routes retain security access across await and stop it in defer. Qi font staging/removal is awaited off main. Cancellation before a settings mutation starts rejects; after the detached transaction starts its result is awaited so a commit cannot be dropped.",
    "suiteOwnership": "New methods extend the existing @MainActor UserFontSettingsTests with one serialized suite. A second independently serialized font suite was not introduced. The selected ReaderFontCatalog selection method is synchronous and restores its changes without an await.",
    "rawExecutionGate": "The local-product gate requires exact selected method identifiers, method/container Passed results, one selected device/configuration, explicit zero skips/failures/expected failures, and unique nonempty Passed Arguments leaves with exact per-method execution counts. Summary counts alone cannot pass.",
    "sourceAndWorkflowBinding": "The selected source signatures, argument declarations, one font-suite ownership/serialization, method/execution inventory, smoke invocation, CLI result path, and narrowly updated workflow summary agree."
  },
