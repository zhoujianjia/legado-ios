+#!/usr/bin/env python3
+"""Owned synthetic shape/negative guards only; never Swift/device observations."""
+import copy
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location("reader_launch_memory_guards", HERE / "reader-launch-memory.py")
+guard = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(guard)
+
+
+def launch_rows():
+    text = "第三章 林間\nLOCAL_READER_SMOKE_RESUME_P0000. first readable text."
+    expected = {"schemaVersion": 1, "boundary": "cpu-layer-submitted-and-ax-readable", "processID": 6000,
+                "processObservationID": "owned-prepare-process", "viewID": "owned-prepare", "viewBindingRevision": 2, "spineIndex": 2, "pageIndex": 0,
+                "pageStartUTF16": 0, "pageLengthUTF16": guard.utf16(text), "documentLengthUTF16": 2048,
+                "pageText": text, "imageSource": "drawn", "submissionUptimeSeconds": 90.0}
+    result = []
+    for iteration in range(5):
+        base = 100.0 + iteration
+        actual = dict(expected, processID=6100 + iteration, viewID="owned-view-%d" % iteration,
+                      processObservationID="owned-process-%d" % iteration,
+                      submissionUptimeSeconds=base + 0.65)
+        row = {"schemaVersion": 1, "kind": "reader-process-launch", "timingProcess": "separate-xctest-ui-runner",
+               "observedProcess": "debug-app-under-ui-automation",
+               "boundary": "launch-request-to-cpu-layer-submitted-and-ax-readable-visible-anchor",
+               "fixturePreparationInsideInterval": False, "originalImportInputRemoved": True,
+               "measuredLaunchImports": False, "systemCachesPurged": False, "deviceCold": False,
+               "gpuPresentationMeasured": False, "improvementEstablished": False,
+               "launchToReadableIncludesAutomationNavigation": True,
+               "runID": "owned-synthetic-launch", "iteration": iteration,
+               "expectedMarker": "LOCAL_READER_SMOKE_RESUME_P0000.",
+               "expectedMarkerUTF16": guard.utf16(text.split("LOCAL_", 1)[0]),
+               "expected": expected, "observed": actual,
+               "timestamps": dict(zip(guard.TIMES, [base + i / 10 for i in (0, 1, 2, 3, 4, 5, 8)])),
+               "complete": True, "terminalPhase": "complete"}
+        row.update(guard.launch_fixture_protocol())
+        result.append(row)
+    return result
+
+
+def memory_row(fixture, iteration, duration=0.029, ticks=(0.0105, 0.0205)):
+    base = 100.0 + iteration
+    events = [{"name": name, "uptimeSeconds": base + duration * i / (len(guard.STAGES) - 1)}
+              for i, name in enumerate(guard.STAGES)]
+    points = [{"kind": "boundary", "phase": event["name"], "beforeUptimeSeconds": event["uptimeSeconds"] + 0.00001,
+               "afterUptimeSeconds": event["uptimeSeconds"] + 0.000011} for event in events]
+    for tick in ticks:
+        phase = [event["name"] for event in events if event["uptimeSeconds"] <= base + tick][-1]
+        points.append({"kind": "periodic", "phase": phase,
+                       "beforeUptimeSeconds": base + tick, "afterUptimeSeconds": base + tick + 0.000001})
+    points.sort(key=lambda point: point["beforeUptimeSeconds"])
+    for index, point in enumerate(points):
+        point.update(footprintBytes=10_000_000 + index * 100, residentBytes=12_000_000 + index * 200,
+                     kernelReturn=0, sufficientReturnCount=True, onMain=False)
+    periodic = [point for point in points if point["kind"] == "periodic"]
+    timeline = [points[0]] + periodic + [points[-1]]
+    measurement = {"processID": 7000, "beginUptimeSeconds": points[0]["beforeUptimeSeconds"],
+                   "endUptimeSeconds": points[-1]["afterUptimeSeconds"], "complete": True, "errors": [],
+                   "periodicSamples": len(periodic), "maximumObservedGapMilliseconds": max(
+                       (b["beforeUptimeSeconds"] - a["beforeUptimeSeconds"]) * 1000 for a, b in zip(timeline, timeline[1:])),
+                   "baselineFootprintBytes": points[0]["footprintBytes"], "baselineResidentBytes": points[0]["residentBytes"],
+                   "sampledPeakFootprintBytes": max(point["footprintBytes"] for point in points),
