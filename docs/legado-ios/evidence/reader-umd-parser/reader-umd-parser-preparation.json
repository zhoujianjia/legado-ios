  "implementation": {
    "decoder": "Pure synchronous bounded operation, explicitly intended for owned worker. Magic/type/record framing; single metadata fields; offset/title/key/index identity; exact EOF size; no trailing input; all UTF16 explicit surrogate validation; decode only after concatenating inflated blocks.",
    "budgets": {
      "inputBytes": 67108864,
      "outputUTF16LEBytes": 33554432,
      "chapters": 16384,
      "records": 65536,
      "inflateScratchBytes": 16384,
      "fileReadChunkBytes": 65536,
      "fileEOFProbeBytes": 1
    },
    "memoryLimitMeaning": "Logical input/output budgets plus bounded scratch; Data/Array/String/raw-chapter copies add memory. No measured RSS/peak/device memory claim.",
    "zlib": "Existing app import zlib; inflateInit2_ positive MAX_WBITS accepts zlib wrapper only; every init success has defer inflateEnd; borrowed input/output pointers used inside their buffer scopes; reject non-OK/non-END/no-progress/dictionary; require STREAM_END and avail_in zero for checksum/full stream/tail.",
    "cancellation": "File load runs Task.detached and forwards caller cancellation; joins worker. Polls in file reads, record loop, inflate loop, UTF16 validation passes and per chapter. No new queue/GCD/sleep/retry. No filesystem writes or staging exists in this read-only preparation.",
    "parserContract": "UMDBookParser conforms to existing BookParser and exposes Snapshot(originalBytes,document) for future transaction. Its generic ParsedBookDocument projection has body strings only; it must not be product-imported with storageText because that model loses UMD titles/offsets.",
    "strictProjectPolicy": [
      "type 1 only; image type2 rejected",
      "nonzero F1 license/key placeholder, all unknown sections, covers and unsupported variants rejected",
      "only observed section flags/order/identity accepted; duplicate chunk random IDs rejected",
      "positive even declared total; exact complete chapter offsets, no malformed surrogate repair",
      "invalid zlib wrapper/checksum/stall/tail/truncation and exceeded budgets rejected"
    ],
    "strictPolicyNotOriginalJavaBehavior": "Original Java was executed only for valid fixtures; no original malformed-input exception or blanket DRM detection is claimed.",
    "instrumentation": "Existing SourcePerfTrace umd.parse limitBytes/main and umd.decode actual bytes/main spans inside detached file worker.",
    "productionIntegration": "BookParserRegistry, LocalBookImportService, BookStore, Reader, Works TOC, Info.plist, UI/localization and CI are unchanged. UMDBookParser is intentionally unregistered."
  },
