  "staticReview": {
    "zlibLifecycle": {
      "source": "Modules/Core/UMD/UMDTextDecoder.swift:174",
      "finding": "No confirmed lifecycle defect found. A successful inflateInit2_ is immediately paired with defer inflateEnd on normal return, malformed input, budget failure and cooperative cancellation. Failed init exits before that defer.",
      "pointers": "All inflate calls occur inside the input Data borrow and current mutable scratch-buffer borrow. next_in remains within the live input borrow across iterations; next_out is reset inside each scratch borrow before inflate. No user buffers are read by application code through the stored C pointers after their scopes. Cached zlib manual documents inflateEnd freeing stream-owned allocations rather than caller input/output buffers.",
      "availabilityBoundary": "This is a source/API-contract review, not actual Apple zlib Swift import/signature validation. Existing app code already imports zlib, but the three new Swift files still need an Apple SDK build."
    },
    "compressedStreamCompletion": {
      "finding": "Positive MAX_WBITS selects the zlib wrapper. Accepted blocks must reach Z_STREAM_END with avail_in equal to zero; checksum failures, NEED_DICT, other non-OK codes, no-progress loops, truncation and unconsumed compressed tails cannot be accepted by this loop.",
      "boundedProgress": "Each inflate call has a 16384-byte scratch output. The loop either makes measurable input/output progress, returns a complete stream, or throws. The frozen tests prepare corrupt-wrapper/checksum/tail coverage, but none of those Swift tests has executed."
    },
    "budgetsAndIntegerBounds": {
      "finding": "Input, declared output, chapters and records are checked before their bounded operations. The per-block remaining output budget is checked before appending output. Cursor reads check nonnegative count against remaining bytes before slicing. UInt32 record values fit the app's 64-bit iOS Int; index storage is bounded by record/input limits.",
      "defaults": {
        "inputBytes": 67108864,
        "outputUTF16LEBytes": 33554432,
        "chapters": 16384,
        "records": 65536,
        "inflateScratchBytes": 16384,
        "fileReadChunkBytes": 65536
      },
      "memoryBoundary": "These are logical byte/count budgets. Input Data/Array copies, decompressed content, per-chapter raw Data, UTF16 unit arrays and String copies add memory; no measured peak RSS, device memory or performance result is asserted. A scratch inflate can produce at most one 16KiB chunk beyond remaining logical output before rejection; that output is not appended."
    },
    "cancellationAndFileOwnership": {
      "source": "Modules/Core/UMD/UMDBookParser.swift:24",
      "finding": "The public file load creates an owned detached worker, forwards parent cancellation via withTaskCancellationHandler and awaits the worker result. It checks cancellation in the bounded read loop, decoder record/inflate/UTF16 loops and chapter assembly; closes the FileHandle on success and failure; and returns the same validated source bytes as Snapshot.originalBytes. It performs no writes or staging.",
      "inputReadBoundary": "Reads are at most 65536 bytes and at most the remaining logical budget plus a one-byte EOF probe. Bytes exceeding the budget are rejected before append; custom large positive limits avoid remaining+1 overflow through the branch condition.",
      "limits": "Cancellation is cooperative between filesystem/C/Foundation operations. The review supplies no cancellation latency, cancellation-during-blocking-read or actual execution evidence. External security-scope and checked durable import leases are outside this unregistered read-only preparation."
    },
    "recordAndUTF16Semantics": {
      "finding": "Checked framing requires the UMD magic, a single type-1 header, known flags and section payload lengths, exact offset/title identities, unique chunk IDs, the reversed final chunk index, exact declared output and exact EOF size. Chapter offsets begin at zero and must be even, monotonic and within the complete concatenated output.",
      "utf16": "UTF16LE code units are assembled explicitly; high/low surrogate validity is checked before String decoding. Raw bytes and byte offsets are retained. Compressed blocks are concatenated before chapter decoding, so a valid pair split across compression blocks remains valid; a chapter boundary splitting a pair is rejected. Only U+2029 is replaced with LF for the public content projection, and exact UTF16-array comparisons are prepared to avoid hiding normalization differences behind String equality.",
      "strictPolicyBoundary": "Rejection of type2, nonzero license/key placeholders, unsupported records, tails and malformed data is project strict subset policy. It is not evidence of original Java rejection, a DRM detector or general UMD compatibility. Original Java was exercised only for the five valid owned fixtures."
    },
