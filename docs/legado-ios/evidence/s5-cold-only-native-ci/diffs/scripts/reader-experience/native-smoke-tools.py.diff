+def validate_cold_tag():
+    source = smoke.source_sha()
+    name = "legado-native-reader-test-cold-" + source[:7]
+    if (os.environ.get("GITHUB_SHA") != source or os.environ.get("GITHUB_REF_NAME") != name
+            or os.environ.get("GITHUB_REF") != "refs/tags/" + name):
+        raise ValueError("Expected exact cold-only tag ref and matching checkout SHA")
+    return source
+
+
+def _admission_validator(admission):
+    if admission == "full":
+        return validate_tag
+    if admission == "cold-only":
+        return validate_cold_tag
+    raise ValueError("Unknown native execution admission")
+
+
+def cold_build_commands(work):
+    destination = os.environ.get("YUEDU_DEST", "")
+    if re.fullmatch(r"id=[0-9A-Fa-f]{8}(?:-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}", destination) is None:
+        raise ValueError("Cold build requires an explicit owned Simulator destination")
+    base = ["xcodebuild", "-project", "Yuedu-Reader.xcodeproj", "-scheme", "Yuedu-Reader",
+        "-destination", destination, *_build_args()]
+    return [base + ["build-for-testing"], base + ["-showBuildSettings", "-json"]]
+
+
+def _cold_built_app(work, source):
+    settings = smoke.read_json(work / "build-settings.json")
+    matches = [row["buildSettings"] for row in settings if row.get("target") == smoke.config.MAIN_TARGET]
+    if len(matches) != 1:
+        raise ValueError("Cold build requires exactly one main reader App")
+    actual = matches[0]
+    for key, value in {"CONFIGURATION": "Debug", "PLATFORM_NAME": "iphonesimulator", "SWIFT_VERSION": "5.0",
+            "ENABLE_DEBUG_DYLIB": "NO", "PRODUCT_BUNDLE_IDENTIFIER": smoke.config.MAIN_BUNDLE}.items():
+        if actual.get(key) != value:
+            raise ValueError("Unexpected cold build setting: " + key)
+    if "LEGADO_REQUIRE_NATIVE_MAINJS" not in actual.get("SWIFT_ACTIVE_COMPILATION_CONDITIONS", "").split():
+        raise ValueError("Cold build must require the real native runtime")
+    app = smoke.config.checked_path(Path(actual["TARGET_BUILD_DIR"]) / actual["FULL_PRODUCT_NAME"])
+    info = smoke.config.read_info(app)
+    smoke.require_local_info(info); smoke.require_source_stamp(info, source)
+    if info.get("CFBundleSupportedPlatforms") != ["iPhoneSimulator"]:
+        raise ValueError("Cold build requires a real Simulator App")
+    return app
+
+
+def _cold_build_products(work, source):
+    app = _cold_built_app(work, source)
+    restored = smoke.read_json(work / "native-restore.json")
+    if (not os.environ.get("GITHUB_RUN_ID") or restored.get("sourceCommit") != source
+            or restored.get("workflowRunID") != os.environ["GITHUB_RUN_ID"]
+            or restored.get("admission") != "cold-only" or restored.get("status") != "restored"):
+        raise ValueError("Cold native restoration must belong to this source and run")
+    ordinary = smoke.read_json(work / "ordinary-jar.json")
+    if ordinary != packaging.inspect_jar(packaging.JAR) or ordinary.get("testClassesIncluded") is not False:
+        raise ValueError("Cold build must retain this checkout's ordinary audited JAR")
+    runtime = smoke.config.verify_jvm_payload(app)
+    if runtime.get("jar") != ordinary:
+        raise ValueError("Cold App runtime differs from the audited ordinary JAR")
+    if smoke.read_json(work / "native-exports.json").get("requiredDynamicExportsPresent") is not True:
+        raise ValueError("Cold App must preserve the actual native exports")
+    return {"app": str(app), "executable": _fact(app / "YueduReader"), "info": _fact(app / "Info.plist"),
+        "runtime": runtime, "nativeRestoration": _fact(work / "native-restore.json"),
+        "ordinaryJarAudit": _fact(work / "ordinary-jar.json"), "nativeExports": _fact(work / "native-exports.json")}
+
