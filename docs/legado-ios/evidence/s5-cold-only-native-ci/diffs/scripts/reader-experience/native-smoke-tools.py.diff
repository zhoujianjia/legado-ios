+def verify_cold_build(work):
+    source = _source_state(work, "cold-only")
+    ledger = smoke.read_json(work / "cold-build-execution.json")
+    if (ledger.get("admission") != "cold-only" or ledger.get("error") is not None
+            or ledger.get("sourceBefore") != source or ledger.get("sourceAfter") != source):
+        raise ValueError("Missing, failed or changed-source cold build")
+    app = _cold_built_app(work, source["sourceCommit"])
+    commands = cold_build_commands(work) + [[sys.executable, "-B", str(smoke.REPO / "scripts/legado-ios/verify-native-exports.py"),
+        "--executable", str(app / "YueduReader"), "--report", str(work / "native-exports.json")]]
+    outputs = ("native-build.log", "build-settings.json", "native-exports-driver.log")
+    actual_commands = ledger.get("commands")
+    if not isinstance(actual_commands, list) or len(actual_commands) != 3:
+        raise ValueError("Cold build requires all three actual commands")
+    for actual, argv, name, budget in zip(actual_commands, commands, outputs, (3600, 60, 60)):
+        output = work / name
+        if (actual.get("argv") != argv or type(actual.get("exitCode")) is not int or actual["exitCode"] != 0
+                or actual.get("timedOut") is not False or type(actual.get("timeoutSeconds")) is not int
+                or actual["timeoutSeconds"] != budget or actual.get("output") != name
+                or actual.get("stdout") != _fact(output) or actual.get("stderr") != name + ".stderr.log"
+                or actual.get("stderrFact") != _fact(output.with_name(name + ".stderr.log"))):
+            raise ValueError("Cold build command failed, timed out or lost its raw evidence")
+    result = smoke.read_json(work / "cold-build-result.json")
+    products = _cold_build_products(work, source["sourceCommit"])
+    if result != {"schemaVersion": 1, "admission": "cold-only", "status": "built-for-cold-two-hosts",
+            "sourceState": source, "buildExecution": _fact(work / "cold-build-execution.json"), "products": products,
+            "actualExecutedTests": 0}:
+        raise ValueError("Cold build products or result changed")
+    return result
+
