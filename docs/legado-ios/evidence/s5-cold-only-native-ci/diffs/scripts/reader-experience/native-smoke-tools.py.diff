+def build_cold(work):
+    if sys.platform != "darwin":
+        raise ValueError("Actual cold build requires Apple Simulator")
+    before = _source_state(work, "cold-only")
+    if any((work / name).exists() for name in ("cold-build-execution.json", "cold-build-result.json",
+            "native-build.log", "build-settings.json", "native-exports.json", "native-exports-driver.log")):
+        raise ValueError("Refusing to overwrite an earlier cold build")
+    commands = []; error = None; after = None; products = None
+    try:
+        for argv, name, budget in zip(cold_build_commands(work), ("native-build.log", "build-settings.json"), (3600, 60)):
+            row = _capture(argv, work / name, budget); commands.append(row)
+            if row["exitCode"] != 0 or row["timedOut"] is not False:
+                raise ValueError("Cold build command failed or timed out")
+        app = _cold_built_app(work, before["sourceCommit"])
+        argv = [sys.executable, "-B", str(smoke.REPO / "scripts/legado-ios/verify-native-exports.py"),
+            "--executable", str(app / "YueduReader"), "--report", str(work / "native-exports.json")]
+        row = _capture(argv, work / "native-exports-driver.log", 60); commands.append(row)
+        if row["exitCode"] != 0 or row["timedOut"] is not False:
+            raise ValueError("Cold native export verification failed or timed out")
+        after = _source_state(work, "cold-only")
+        if before != after:
+            raise ValueError("Cold source changed during compilation")
+        products = _cold_build_products(work, before["sourceCommit"])
+    except Exception as failure:
+        error = type(failure).__name__ + ": " + str(failure)[:2048]
+    smoke.config.write_new_json(work / "cold-build-execution.json", {"schemaVersion": 1, "admission": "cold-only",
+        "sourceBefore": before, "sourceAfter": after, "commands": commands, "error": error})
+    if error is not None:
+        raise ValueError(error)
+    result = {"schemaVersion": 1, "admission": "cold-only", "status": "built-for-cold-two-hosts",
+        "sourceState": after, "buildExecution": _fact(work / "cold-build-execution.json"), "products": products,
+        "actualExecutedTests": 0}
+    smoke.config.write_new_json(work / "cold-build-result.json", result)
+    return verify_cold_build(work)
+
