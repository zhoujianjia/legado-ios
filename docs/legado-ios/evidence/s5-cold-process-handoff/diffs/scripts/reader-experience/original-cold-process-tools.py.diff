+def renewal_uuid(value):
+    if not isinstance(value, str) or re.fullmatch(
+            r'[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}', value) is None:
+        raise ValueError('Malformed cold renewal identity')
+    return uuid.UUID(value)
+
+
+def renewal_hash(value):
+    return isinstance(value, str) and re.fullmatch('[0-9a-f]{64}', value) is not None
+
+
+def renewal_uint(value, maximum):
+    return type(value) is int and 0 < value <= maximum
+
+
+def renewal_common(value, fields):
+    if (not isinstance(value, dict) or set(value) != fields
+            or type(value['schemaVersion']) is not int or value['schemaVersion'] != 1
+            or value['phase'] != 'receiptObserved'
+            or not renewal_uint(value['revision'], (1 << 64) - 1)
+            or not renewal_uint(value['candidateBytes'], (1 << 63) - 1)
+            or not renewal_hash(value['candidateSHA256']) or not renewal_hash(value['recordSHA256'])
+            or value['installedMaterial'] is not None or value['installedDifferentProcess'] is not None
+            or value['renewalVerified'] is not False
+            or type(value['clockEpochSeconds']) not in (int, float)):
+        raise ValueError('Missing or invalid controlled renewal receipt')
+    try:
+        finite_clock = math.isfinite(value['clockEpochSeconds'])
+    except OverflowError:
+        finite_clock = False
+    if not finite_clock:
+        raise ValueError('Nonfinite controlled renewal clock')
+    renewal_uuid(value['transactionID']); renewal_uuid(value['handoffProcessID'])
+    return value
+
+
+def validate_producer_renewal(value, producer):
+    value = renewal_common(value, RENEWAL_PRODUCER_FIELDS)
+    selected = value['files']
+    position_path = 'positions/' + producer['bookID'] + '.json'
+    if (renewal_uuid(value['preparationProcessID']) != renewal_uuid(value['handoffProcessID'])
+            or not isinstance(selected, dict) or set(selected) != {'shelf', 'reading', 'sources'}
+            or any(not renewal_hash(h) for h in selected.values())
+            or selected != {'shelf': producer['files']['books_meta.json'],
+                            'reading': producer['files']['books_meta.reading.json'],
+                            'sources': producer['files']['book_sources.json']}
+            or not renewal_hash(value['positionSHA256'])
+            or value['positionSHA256'] != producer['positionSHA256']
+            or value['positionSHA256'] != producer['files'][position_path]
+            or not renewal_uint(value['positionBytes'], (1 << 63) - 1)
+            or type(value['uploadBytes']) is not int or value['uploadBytes'] != value['candidateBytes']
+            or value['uploadSHA256'] != value['candidateSHA256']
+            or type(value['upgradeRequests']) is not int or value['upgradeRequests'] != 1
+            or type(value['lookupRequests']) is not int or value['lookupRequests'] != 1
+            or value['reportedCompleteCleanup'] is not True):
+        raise ValueError('Cold producer did not seal the same candidate and actual data handoff')
+    return value
+
+
+def validate_consumer_renewal(value, producer):
+    value = renewal_common(value, RENEWAL_CONSUMER_FIELDS)
+    if (renewal_uuid(value['transactionID']) != renewal_uuid(producer['transactionID'])
+            or not renewal_uint(value['beforeRevision'], (1 << 64) - 1)
+            or value['beforeRevision'] != producer['revision']
+            or value['revision'] != value['beforeRevision'] + 1
+            or value['beforeRecordSHA256'] != producer['recordSHA256']
+            or value['recordSHA256'] == value['beforeRecordSHA256']
+            or value['candidateBytes'] != producer['candidateBytes']
+            or value['candidateSHA256'] != producer['candidateSHA256']
+            or renewal_uuid(value['handoffProcessID']) != renewal_uuid(producer['handoffProcessID'])
+            or renewal_uuid(value['normalReadProcessID']) == renewal_uuid(producer['preparationProcessID'])
+            or value['clockEpochSeconds'] != producer['clockEpochSeconds']
+            or value['dataReadInDifferentProcess'] is not True or value['selectedFilesMatch'] is not True
+            or value['sourceWasBootstrapped'] is not False or value['unchangedExceptDataRead'] is not True
+            or value['candidateFileUnchanged'] is not True or value['recoveryOnly'] is not True):
+        raise ValueError('Cold consumer is not the same local handoff observation in a new process')
+    return value
+
